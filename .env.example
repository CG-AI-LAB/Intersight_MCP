# Intersight MCP HTTP Server Environment Configuration
# Copy this file to .env and update with your actual values

# Authentication method: oauth2 or apikey
# Optional: defaults to oauth2 when INTERSIGHT_OAUTH2_CLIENT_ID is set, otherwise apikey
INTERSIGHT_AUTH_METHOD=oauth2

# --- OAuth2 (client credentials) ---
# Client ID and secret from an OAuth2 client registered in Intersight
INTERSIGHT_OAUTH2_CLIENT_ID=your_client_id_here
INTERSIGHT_OAUTH2_CLIENT_SECRET=your_client_secret_here
# Alternative to INTERSIGHT_OAUTH2_CLIENT_SECRET: read the secret from a file
# INTERSIGHT_OAUTH2_CLIENT_SECRET_PATH=/app/secrets/oauth2_client_secret
# Optional: token endpoint (defaults to <base URL origin>/iam/token)
# INTERSIGHT_OAUTH2_TOKEN_URL=https://intersight.com/iam/token

# --- API key (HTTP signature) ---
# INTERSIGHT_API_KEY_ID=your_api_key_id_here
# INTERSIGHT_API_SECRET_KEY_PATH=/app/secrets/private_key.pem

# Optional: Intersight API base URL, including /api/v1 (defaults to https://intersight.com/api/v1)
INTERSIGHT_BASE_URL=https://intersight.com/api/v1

# Optional: Server port (defaults to 3000)
PORT=3000

# Example values:
# INTERSIGHT_API_KEY_ID=64f1c3e5c58f4a0001234567/64f1c3e5c58f4a0001abcdef/65a2b4d6e78f9c0001xyz123
# INTERSIGHT_BASE_URL=https://eu-central-1.intersight.com/api/v1
# PORT=8080
